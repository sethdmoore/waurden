# Maintainer: Test User <test@example.com>
pkgname=hello-world
pkgver=1.0
pkgrel=1
pkgdesc="A simple hello world package"
arch=('x86_64')
url="https://example.com"
license=('MIT')
source=("https://example.com/hello-world-1.0.tar.gz")
sha256sums=('abc123def456abc123def456abc123def456abc123def456abc123def456abc123de')

build() {
    cd "$pkgname-$pkgver"
    make
}

package() {
    cd "$pkgname-$pkgver"
    make DESTDIR="$pkgdir" install
}
